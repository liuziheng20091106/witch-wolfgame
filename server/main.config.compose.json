{
  "listen": {
    "host": "0.0.0.0",
    "port": 34022
  },
  "cors": {
    "allowedOrigins": [
      "https://example.com"
    ]
  },
  "proxies": [
    {
      "name": "proxy-primary",
      "url": "https://proxy:34023/internal/v1/chat/completions",
      "ca": "../certs/ca.crt",
      "clientCert": "../certs/main-client.crt",
      "clientKey": "../certs/main-client.key",
      "serverName": "proxy.internal",
      "connectionPasswordEnv": "MAJO_PROXY_PASSWORD_PRIMARY",
      "timeoutMs": 65000
    }
  ],
  "rateLimit": {
    "windowMs": 60000,
    "maxRequests": 20,
    "maxConcurrent": 2
  },
  "acceptedClientVersions": [
    "2.4.0"
  ],
  "proxyUpdatePassEnv": "MAJO_PROXY_UPDATE_PASS",
  "updateNodes": [
    {
      "name": "proxy-primary",
      "url": "https://proxy:34023/update",
      "ca": "../certs/ca.crt",
      "clientCert": "../certs/main-client.crt",
      "clientKey": "../certs/main-client.key",
      "serverName": "proxy.internal",
      "updatePassEnv": "MAJO_PROXY_UPDATE_PASS",
      "updateTimeoutMs": 60000
    }
  ],
  "multiplayerUpdateNodes": [
    {
      "name": "multiplayer",
      "url": "http://multiplayer:34024/update",
      "updatePassEnv": "MAJO_MAIN_UPDATE_PASS",
      "updateTimeoutMs": 90000
    }
  ],
  "update": {
    "passEnv": "MAJO_MAIN_UPDATE_PASS",
    "source": "https://raw.githubusercontent.com/liuziheng20091106/witch-wolfgame/main/{file}",
    "files": [
      "shared/gamePromptContract.js",
      "server/gameProtocol.mjs",
      "server/main.mjs",
      "server/shared.mjs",
      "server/update-core.mjs",
      "server/main.config.compose.json"
    ],
    "projectRoot": ".",
    "downloadTimeoutMs": 30000,
    "downloadAttempts": 3,
    "retryDelayMs": 500,
    "maxRedirects": 5,
    "backupKeepCount": 5,
    "restartSignalFile": ".runtime/restart-token",
    "restartOnSuccess": "code0"
  }
}
