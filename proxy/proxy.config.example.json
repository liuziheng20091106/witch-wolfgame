{
  "listen": { "host": "0.0.0.0", "port": 34023 },
  "tls": {
    "ca": "../certs/ca.crt",
    "cert": "../certs/proxy-server.crt",
    "key": "../certs/proxy-server.key"
  },
  "connectionPasswordEnv": "MAJO_PROXY_PASSWORD_PRIMARY",
  "acceptedClientVersions": ["2.3.1"],
  "providersFile": "./providers.json",
  "upstreamTimeoutMs": 60000,
  "maxAttempts": 4,
  "update": {
    "passEnv": "MAJO_UPDATE_PASS",
    "source": "https://example.com/raw/{file}",
    "files": ["server/gameProtocol.mjs", "proxy/server.mjs"],
    "projectRoot": "/app",
    "downloadTimeoutMs": 30000,
    "restartOnSuccess": true
  }
}
