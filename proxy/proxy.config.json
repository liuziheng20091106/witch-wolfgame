{
  "listen": { "host": "0.0.0.0", "port": 34023 },
  "tls": {
    "ca": "../certs/ca.crt",
    "cert": "../certs/proxy-server.crt",
    "key": "../certs/proxy-server.key"
  },
  "connectionPasswordEnv": "MAJO_PROXY_PASSWORD_PRIMARY",
  "acceptedClientVersions": ["2.3.1"],
  "providersFile": "./providers.json",
  "update": {
    "passEnv": "MAJO_UPDATE_PASS",
    "source": "https://raw.githubusercontent.com/liuziheng20091106/witch-wolfgame/main/{file}",
    "files": [
      "server/gameProtocol.mjs",
      "server/main.mjs",
      "server/shared.mjs",
      "proxy/server.mjs",
      "proxy/update.mjs"
    ],
    "downloadTimeoutMs": 30000,
    "downloadAttempts": 3,
    "retryDelayMs": 500,
    "maxRedirects": 5,
    "restartSignalFile": ".runtime/restart-token",
    "restartOnSuccess": "code0"
  }
}
